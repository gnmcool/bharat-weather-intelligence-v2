# Copy to .env.local for local overrides. All client-side variables must start with VITE_.

# CORE API base URL used by the browser.
#   Local dev default: /api/v1 (Vite proxies /api to BWI_CORE_ORIGIN, see vite.config.ts)
#   Production (GitHub Pages): set in .github/workflows/pages.yml from the repo variable CORE_API_BASE
VITE_CORE_API_BASE=/api/v1

# Label shown in the preview banner: local | preview | production
VITE_APP_ENV=local

# V2 intelligence API base (api-v2/: /events, /evidence, /region/india/risks).
#   Local dev default: /api/v2 (Vite proxies to BWI_API_V2_ORIGIN, default http://127.0.0.1:8702)
#   Production: set in .github/workflows/pages.yml from the repo variable API_V2_BASE
VITE_API_V2_BASE=/api/v2
